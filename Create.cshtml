@model StudyFlow.Models.StudySessionViewModel
@{
    ViewData["Title"] = "Schedule Study Session";
}

<h1>Schedule a New Study Session</h1>
<p style="color:#64748b;margin-bottom:1rem;">Plan when you will study. All fields marked * are required.</p>

<div class="card">
    <form asp-action="Create" method="post" novalidate>
        @Html.AntiForgeryToken()
        <partial name="_SessionForm" model="Model" />
        <div style="display:flex;gap:.75rem;margin-top:1rem;">
            <button type="submit" class="btn btn-primary">Save Session</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
